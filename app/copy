import http.client
import json
import os

from dotenv import load_dotenv


HOST = "open-api.divar.ir"

SEARCH_PATH = "/v2/open-platform/finder/post"
DETAIL_PATH = "/v2/open-platform/post/{}"

load_dotenv()

API_KEY = os.getenv("DIVAR_API_KEY")


REQUIREMENTS = {
    "category": "apartment-sell",
    "city": "tehran",

    "min_price": 10_000_000_000,
    "max_price": 15_000_000_000,

    "min_size": 60,
    "max_size": 80,

    "min_year": 1400,
    "min_rooms": 1,
}


def room_names(min_rooms):
    rooms = ["یک", "دو", "سه", "چهار", "پنج"]
    return rooms[min_rooms - 1:]


def build_query(r):
    return {
        "credit": {
            "min": r["min_price"],
            "max": r["max_price"],
        },
        "size": {
            "min": r["min_size"],
            "max": r["max_size"],
        },
        "production_year": {
            "min": r["min_year"],
        },
        "rooms": room_names(r["min_rooms"]),
    }


def request(method, path, body=None):
    conn = http.client.HTTPSConnection(HOST)

    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "x-api-key": API_KEY,
    }

    try:
        conn.request(
            method,
            path,
            body=json.dumps(body, ensure_ascii=False) if body else None,
            headers=headers,
        )

        response = conn.getresponse()

        raw = response.read().decode("utf-8", errors="replace")

        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            data = raw

        return response.status, data

    finally:
        conn.close()


# ============================================================
# SEARCH
# ============================================================

payload = {
    "category": REQUIREMENTS["category"],
    "city": REQUIREMENTS["city"],
    "districts": [],
    "query": build_query(REQUIREMENTS),
}


print("=" * 80)
print("SEARCH REQUEST")
print("=" * 80)

print(json.dumps(
    payload,
    indent=2,
    ensure_ascii=False
))


status, result = request(
    "POST",
    SEARCH_PATH,
    payload
)


print("\nSEARCH STATUS:", status)


if status != 200:
    print("\nSEARCH ERROR:")
    print(result)
    exit(1)


posts = result.get("posts", []) # type: ignore


print(f"\nFOUND {len(posts)} POSTS")


# ============================================================
# GET FULL DETAILS
# ============================================================

for index, post in enumerate(posts, 1):

    token = post.get("token")

    if not token:
        continue

    print("\n" + "#" * 80)
    print(f"POST #{index}")
    print("#" * 80)

    print("TOKEN:", token)
    print(f"DIVAR URL: https://divar.ir/v/{token}")

    detail_status, detail = request(
        "GET",
        DETAIL_PATH.format(token),
    )

    print("DETAIL STATUS:", detail_status)

    if detail_status != 200:

        print("\nDETAIL ERROR:")
        print(detail)

        continue


    print("\nFULL POST JSON:")

    print(
        json.dumps(
            detail,
            indent=2,
            ensure_ascii=False
        )
    )

